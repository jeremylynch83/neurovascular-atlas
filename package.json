{
  "name": "inr-anatomy-atlas",
  "private": true,
  "version": "0.9.153",
  "description": "Interactive 3D interventional neuroradiology anatomy atlas.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "anatomy:validate": "python3 tools/validate_anatomy.py",
    "anatomy:build": "./build-anatomy.sh",
    "build": "sh ./build-anatomy.sh && node tools/build-dsa-flow.mjs && tsc -b && vite build && node tools/optimise-web.mjs && python3 tools/precompress.py",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "python3 tools/validate_anatomy.py",
    "web:audit": "python3 tools/audit-hosting.py",
    "web:validate": "node tools/validate-viewer-catalogue.mjs",
    "web:startup": "node tools/validate-startup.mjs",
    "web:loading": "node tools/validate-loading.mjs",
    "web:scheduling": "node tools/validate-scheduling.mjs"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "meshoptimizer": "1.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
