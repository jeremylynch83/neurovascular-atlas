{
  "name": "inr-anatomy-atlas",
  "private": true,
  "version": "0.9.39",
  "description": "Interactive 3D interventional neuroradiology anatomy atlas.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "anatomy:validate": "python3 tools/validate_anatomy.py",
    "anatomy:build": "./build-anatomy.sh",
    "build": "./build-anatomy.sh && tsc -b && vite build && python3 tools/precompress.py",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "python3 tools/validate_anatomy.py"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "meshoptimizer": "1.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
