  "decisions": {
    "G02": {
      "status": "geometric-recheck-passed-anatomical-review-limited",
      "pairsChecked": 12,
      "pairsWithSurfaceContacts": 0,
      "conclusion": "All 12 original crossing corrections remain free of triangle intersections in the delivered geometry. Sampled APMV sections at Z=70 and 75 mm are posterior to the basilar artery, consistent with cited anatomical relationship. This is not whole-course or whole-atlas anatomical certification. Tiny sampled clearances should not be interpreted as physiological measurements."
    },
    "G05": {
      "status": "correction-required",
      "conclusion": "Historical G05 is not resolved by the later generic callosal-repair note. Both A2–A5 chains retain matching seam coordinates but all eight segments contact registered brain surfaces. Left A5 also intersects the corpus-callosum surface. A3 remains separated from the registered callosal surface. Retain the issue, extend review to A5, and require coordinated vessel/brain registration and junction review. Do not repeat the previously rejected local displacement trial."
    },
    "G06": {
      "status": "physical-parent-interfaces-unresolved",
      "conclusion": "Anterior ethmoidal origin of anterior falcine arteries is supported and both delivered parent rims share 90 coordinates. A pericallosal dural branch is supported by original dissection; exact A5 origin is an illustrative model assignment. ACA falcine branches have no coordinate matches to A2–A5 and sampled nearest wall distances to A5 are 3.57395 mm left and 2.29410 mm right. MMA falcine terminal parent assignments are retained as provisional; neither shares coordinates with its paramedian parent. ACA-to-MMA connection rims match their endpoints, but upstream gaps prevent acceptance of network continuity. Anterior-falcine-to-MMA connections are closed components, so close proximity does not demonstrate a patent join. Preserve catalogue parent IDs and potential-anastomosis semantics pending a coupled geometry repair."
    }
  }
}
